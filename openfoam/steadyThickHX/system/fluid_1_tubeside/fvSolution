FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }
    rho
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }
    rhoFinal { $rho; }
    "(U|h)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }
    "(U|h)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;
    }
}
PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    20;
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;
    residualControl
    {
        U       1e-4;
        p_rgh   1e-6;
        h       1e-4;
    }
}
relaxationFactors
{
    fields    { p_rgh 0.5; }
    equations { U 0.7; h 0.9; e 0.9; }
}
fieldBounds
{
    p_rgh   1e3  1e8;
    h       1e4  1e8;
    T       200  2000;
}
