FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 300;

boundaryField
{
    top_inlet
    {
        type zeroGradient;   // let temperature evolve naturally
    }

    top_outlet
    {
        type zeroGradient;   // standard outlet
    }

    walls
    {
        type fixedValue;
        value uniform 400ß;   // constant wall temperature
    }
    top_slab_wall
    {
        type fixedValue;
        value uniform 400ß;   // constant wall temperature
    }

    top_fluid_to_slab
    {
        type compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr T;
        kappaMethod fluidThermo;
        value           uniform 400;
    }
}
