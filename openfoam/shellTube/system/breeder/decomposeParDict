FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/breeder";
    object      decomposeParDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 6;

method simple;

simpleCoeffs
{
    n (3 2 1);
    delta 0.001;
}

distributed no;

roots ();
