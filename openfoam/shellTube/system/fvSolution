FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

PIMPLE
{
    nOuterCorrectors 1;
}

relaxationFactors
{
    fields
    {
        T               0.7;   // Temperature relaxation for solid/fluid
    }

    equations
    {
        U               0.3;   // Velocity
    }
}

