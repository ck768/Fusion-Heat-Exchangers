FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "100/coolant";
    object      Qdot;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    coolant_walls
    {
        type            calculated;
        value           uniform 0;
    }
    coolant_inlet
    {
        type            calculated;
        value           uniform 0;
    }
    coolant_outlet
    {
        type            calculated;
        value           uniform 0;
    }
    coolant_to_walls
    {
        type            calculated;
        value           uniform 0;
    }
}


